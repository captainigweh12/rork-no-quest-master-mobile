# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# App URLs
EXPO_PUBLIC_TOOLKIT_URL=https://toolkit.rork.com
EXPO_PUBLIC_APP_BASE_URL=https://8081-i8uit1c71qmgs8e19qjxf-6532622b.e2b.app
EXPO_PUBLIC_EMAIL_REDIRECT=noquest://verify-email

# Backend API - Render deployment
EXPO_PUBLIC_RORK_API_BASE_URL=https://rork-no-quest-master-mobile.onrender.com

# AI providers (optional)
EXPO_PUBLIC_PERPLEXITY_API_KEY=your-key-here
EXPO_PUBLIC_OPENAI_API_KEY=your-key-here
EXPO_PUBLIC_AI_PROVIDER_ORDER=perplexity,openai

# YouTube (Frontend - Public API Key)
EXPO_PUBLIC_YOUTUBE_API_KEY=your-key-here

# YouTube OAuth (Backend - DO NOT expose these in frontend)
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
YOUTUBE_API_KEY=your-youtube-api-key-here

# VideoSDK (for live streaming) - DEPRECATED, use Daily.co instead
VIDEOSDK_API_KEY=your-videosdk-api-key
VIDEOSDK_SECRET_KEY=your-videosdk-secret-key

# Daily.co (for live streaming) - RECOMMENDED
DAILY_API_KEY=your-daily-api-key
EXPO_PUBLIC_DAILY_DOMAIN=your-domain.daily.co

# OTA Updates - Toggle Over-The-Air updates for production builds
# false = disabled (recommended during development/stabilization)
# true = enabled (use when shipping to production via EAS Build)
OTA_ENABLED=false
